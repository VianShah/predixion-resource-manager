# Copy this file to .env and fill in the values. Never commit .env.
# Anything left blank simply turns that collector off; the dashboard says so.

# ---------- General ----------
RM_DB_PATH=data/rm.sqlite
RM_LOG_LEVEL=INFO
# Shared secret for the write endpoints (usage ingest, manual balances, collect). Make it long and random.
RM_INGEST_TOKEN=
# Rate used to show AWS dollars in rupees. Set the rate you want to report in.
USD_INR=88.0
# Server bind. Keep 127.0.0.1 locally. On Render use 0.0.0.0 AND set RM_DASHBOARD_PASSWORD (server refuses to start otherwise).
RM_HOST=127.0.0.1
RM_PORT=8080
# Login for the dashboard (HTTP Basic). Required whenever RM_HOST is not loopback. Long and random.
RM_DASHBOARD_USER=admin
RM_DASHBOARD_PASSWORD=
# Pull AWS + Vobiz automatically every N minutes (0 = off). 15 is a sensible start; Cost Explorer API calls cost money (VERIFY current rate).
RM_COLLECT_INTERVAL_MIN=0

# ---------- AWS ----------
# Prefer an SSO profile or an instance/task role. Use keys only if you must.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 12-digit account that owns the credits
AWS_ACCOUNT_ID=
# Cost tag keys used to say what spend is for. Activate them in Billing > Cost allocation tags first.
AWS_TAG_CLIENT=client
AWS_TAG_PRODUCT=product
AWS_TAG_ENV=env
# Optional monthly budget in USD, used for the forecast alert
AWS_MONTHLY_BUDGET_USD=

# ---------- Vobiz ----------
# Auth ID looks like MA_XXXXXXXX. Token from the Vobiz console.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_BASE_URL=https://api.vobiz.ai
VOBIZ_CURRENCY=INR

# ---------- Interakt (WhatsApp) ----------
# The Secret Key you typed into Interakt > Settings > Developer Settings when you set the webhook URL.
INTERAKT_WEBHOOK_SECRET=

# ---------- Sarvam ----------
# Plan used to price usage events: payg, pro or growth (see Sarvam dashboard > Settings > Plans & pricing)
SARVAM_PLAN=payg
# Sarvam documents no usage API. Your voice agents report usage to /api/ingest/sarvam instead.
# The Sarvam API key is NOT needed by this project. Do not put it here.
